STORE_CORS=http://localhost:8000,https://docs.medusajs.com
ADMIN_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
AUTH_CORS=http://localhost:5173,http://localhost:9000,https://docs.medusajs.com
REDIS_URL=redis://localhost:6379
JWT_SECRET=supersecret
COOKIE_SECRET=supersecret
DATABASE_URL=
DB_NAME=medusa-backend

# Stripe: use matching test keys while developing. Add the webhook signing
# secret when you create the Stripe endpoint for this backend.
STRIPE_API_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe Tax stays disabled until the business has confirmed its tax
# registrations and configured its head office and registrations in Stripe.
STRIPE_TAX_ENABLED=false
STRIPE_TAX_PRODUCT_CODE=txcd_99999999

# Shippo: begin with a test token from the Shippo API settings.
SHIPPO_API_TOKEN=
# One box for each fulfillment. Product variant weights are grams.
SHIPPO_PARCEL_LENGTH_CM=25
SHIPPO_PARCEL_WIDTH_CM=20
SHIPPO_PARCEL_HEIGHT_CM=10

# Sender email required by Shippo for label creation.
SHIPPO_FROM_EMAIL=

# Klaviyo: enable after creating an email list and a scoped private API key.
KLAVIYO_ENABLED=false
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_LIST_ID=
